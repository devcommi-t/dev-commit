# All optional. Set these in your hosting dashboard (never commit real values).
PORT=3000
NODE_ENV=production
# Create the first admin from the environment instead of `npm run create-admin`:
ADMIN_EMAIL=devcommitt@gmail.com
ADMIN_PASSWORD=choose-a-long-unique-password-12+chars
# Set to 1 only when running behind a proxy you control (Render, Railway, Nginx...)
TRUST_PROXY=1
SITE_URL=https://your-domain.com
# Use an external form service instead of the built-in inbox:
# FORM_ENDPOINT=https://formspree.io/f/your-form-id
# Optional transactional email via Resend (verify the sender domain first).
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=dev.commit <hello@your-domain.com>
ADMIN_NOTIFY_EMAIL=devcommitt@gmail.com
# Number of trusted proxies in front of the server (default 1). Used to read the real client IP.
# PROXY_HOPS=1
# Only allow the admin from these IPs (comma-separated). Leave unset to allow everywhere.
# ADMIN_ALLOWED_IPS=203.0.113.10
